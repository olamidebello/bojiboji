# Paste this location into the Bojiboji domain's existing Olamidepanel
# Nginx server block. Do not add a second location / if one exists;
# replace that domain's existing application location instead.
# Keep the panel's TLS/certificate configuration in the enclosing block.
location / {
    proxy_pass http://127.0.0.1:{{ bojiboji_port }};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 90s;
    client_max_body_size 200k;
}

# The EventSource URL carries a temporary room credential.
# Do not write it into the standard access log.
location = /events {
    proxy_pass http://127.0.0.1:{{ bojiboji_port }};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 90s;
    access_log off;
}
